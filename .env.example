# --- Server ---
# Puerto HTTP del servidor
PORT=3000
# URL pública de la app (usada en sitemap.xml). En Railway: https://<tu-app>.up.railway.app
PUBLIC_URL=https://trailexplorer.com
# Directorio de datos persistente (DB e imágenes). En Railway: /data
DATA_DIR=
# Directorio de imágenes (por defecto DERIVA de DATA_DIR o server/public/images)
IMAGES_DIR=
# Ruta al build del cliente (por defecto server/../../client/dist)
CLIENT_DIST=

# --- Cliente (build-time) ---
# URL pública del backend. Debe ser accesible desde el navegador.
# En producción con el backend sirviendo el frontend, usa la misma PUBLIC_URL.
VITE_SERVER_URL=http://localhost:3001
# URL canónica del sitio (para SEO/canonical/hreflang)
VITE_SITE_URL=https://trailexplorer.com
