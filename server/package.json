{
  "name": "trail-explorer-server",
  "version": "1.0.0",
  "description": "Backend API for Trail Explorer",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "download-images": "node src/download-images.js",
    "reset-db": "node src/reset-db.js",
    "build:client": "cd ../client && npm ci && npm run build",
    "build": "npm run build:client"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "sharp": "^0.34.5",
    "sql.js": "^1.10.3",
    "uuid": "^9.0.1"
  }
}
